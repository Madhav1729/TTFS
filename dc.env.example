# Design Compiler settings for synth / power / fetch.  Copy to dc.env, fill in, then: source dc.env
# Leave TTFS_DC_HOST empty to run dc_shell on this machine.
export TTFS_DC_HOST=""          # ssh host name or alias of the machine with Design Compiler
export TTFS_DC_USER=""          # ssh user name (empty: from ~/.ssh/config)
export TTFS_DC_PORT="22"        # ssh port
export TTFS_DC_KEY=""           # private key file (empty: ssh-agent or ~/.ssh/config)
export TTFS_DC_WORKDIR=""       # writable directory on that machine for the run folders (required for a remote host)
export TTFS_DC_SETUP=""         # command that puts dc_shell on PATH, e.g. "source /tools/synopsys/setup.sh"
